# Copy to apps/api/.env before running the API.

# Local: docker compose up -d postgres, then use the URL below.
# Railway: set DATABASE_URL=${{Postgres.DATABASE_URL}} on the API service.
DATABASE_URL="postgresql://marble:marble@localhost:5432/marble"

# V1 login uses JWT. Bootstrap token still works for API tests / local tooling.
# The normal seed creates only platform data. Use db:seed:pilot only for local
# development when a fixed Binhaj workspace is needed.
BOOTSTRAP_TOKEN="binhaj-dev-token"
BOOTSTRAP_COMPANY_SLUG="binhaj-marble"
JWT_SECRET="marble-pilot-jwt-change-me"
JWT_EXPIRES_IN="7d"
SESSION_IDLE_MINUTES="30"
SESSION_ABSOLUTE_DAYS="7"
# 64 hex characters; used to encrypt the one-time operator demo credential handoff.
DEMO_CREDENTIALS_KEY="replace-with-64-hex-characters"
WEB_APP_URL="https://enterprise-hub.up.railway.app"
MOBILE_APP_URL="https://expo.dev/accounts/preuqaliq/projects/marble-with-nuage"
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
MAIL_FROM="PrequaliQ <info@prequaliq.com>"
MAIL_REPLY_TO="info@prequaliq.com"
DEMO_CLEANUP_ENABLED="false"
# DEMO_CLEANUP_INTERVAL_MS="3600000"
# Optional override for the local pilot owner password (default: binhaj123)
# SEED_OWNER_PASSWORD="binhaj123"
# Required in production; never use the local fallback values.
PLATFORM_ADMIN_EMAIL="admin@example.com"
PLATFORM_ADMIN_PASSWORD="replace-with-a-long-random-password"

PORT=3001
HOST=0.0.0.0

# Optional. Production Docker defaults to /data/uploads (Railway Volume mount).
# UPLOADS_DIR="/data/uploads"

# Comma-separated allowed browser origins. Leave unset for local development
# (any origin is reflected); always set this for staging and production.
# CORS_ORIGINS="https://your-web.up.railway.app"

# Optional: Postgres admin URL for API integration tests (defaults to local docker).
# TEST_DATABASE_ADMIN_URL="postgresql://marble:marble@localhost:5432/postgres"
