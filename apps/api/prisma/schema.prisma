generator client {
  provider = "prisma-client-js"
}

// Local Phase 0: SQLite. Switch provider to "postgresql" when Docker Postgres is available.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile   CompanyProfile?
  users     User[]
  auditLogs AuditLog[]
  suppliers Supplier[]
  products  Product[]
  customers Customer[]
}

model CompanyProfile {
  id              String  @id @default(cuid())
  companyId       String  @unique
  legalName       String
  tradeName       String?
  address         String?
  phone           String?
  email           String?
  trn             String?
  bankDetails     String?
  logoUrl         String?
  signatureUrl    String?
  quotationPrefix String  @default("QT")
  invoicePrefix   String  @default("INV")
  currency        String  @default("AED")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model User {
  id        String   @id @default(cuid())
  companyId String
  email     String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, email])
}

model Supplier {
  id        String   @id @default(cuid())
  companyId String
  name      String
  contact   String?
  phone     String?
  email     String?
  address   String?
  trn       String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([companyId, name])
}

model Product {
  id            String   @id @default(cuid())
  companyId     String
  supplierId    String?
  name          String
  sku           String?
  unit          String   @default("sqm")
  purchasePrice Float    @default(0)
  sellPrice     Float    @default(0)
  description   String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  images   ProductImage[]

  @@index([companyId, name])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Customer {
  id        String   @id @default(cuid())
  companyId String
  name      String
  contact   String?
  phone     String?
  email     String?
  address   String?
  trn       String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, name])
}

model AuditLog {
  id         String   @id @default(cuid())
  companyId  String
  actorId    String?
  entityType String
  entityId   String
  action     String
  beforeJson String?
  afterJson  String?
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, entityType, entityId])
  @@index([companyId, createdAt])
}
