  jobValue      Float     @default(0)
  /// Net of VAT, used for margin so collected VAT is not counted as revenue.
  jobNet        Float     @default(0)
  purchaseTotal Float     @default(0)
  completedAt   DateTime?
  closedAt      DateTime?
  version       Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer  Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quotation Quotation        @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  invoices  Invoice[]
  advances  AdvancePayment[]
  ledger    LedgerEntry[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([companyId, customerId])
  @@index([companyId, updatedAt])
  @@index([sampleSetId])
}

model Invoice {
  id         String  @id @default(cuid())
  companyId  String
  sampleSetId String?
  sampleKey String?
  customerId String
  jobId      String?
  number     String
  kind       String
  status     String  @default("draft")

  issueDate DateTime  @default(now())
  dueDate   DateTime?
  notes     String?

  discountMode      String @default("none")
  discountValue     Float  @default(0)
  discount          Float  @default(0)
  lineDiscountTotal Float  @default(0)
  subtotal       Float @default(0)
  vatAmount      Float @default(0)
  total          Float @default(0)
  purchaseTotal  Float @default(0)
  /// Advance shown as settled on this document; see InvoiceAdvanceAllocation.
  advanceApplied Float @default(0)
  netPayable     Float @default(0)

  creditNoteForId String?
  cancelledAt     DateTime?
  version         Int       @default(1)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company       Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer      Customer                   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  job           Job?                       @relation(fields: [jobId], references: [id], onDelete: SetNull)
  creditNoteFor Invoice?                   @relation("CreditNotes", fields: [creditNoteForId], references: [id], onDelete: SetNull)
  creditNotes   Invoice[]                  @relation("CreditNotes")
  lines         InvoiceLine[]
  allocations   InvoiceAdvanceAllocation[]
  ledger        LedgerEntry[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([companyId, customerId])
  @@index([companyId, jobId])
  @@index([companyId, updatedAt])
  @@index([sampleSetId])
}

model InvoiceLine {
  id            String @id @default(cuid())
  invoiceId     String
  description   String
  unit          String @default("sqm")
  qty           Float
  unitPrice     Float
  /// Snapshot of cost so invoice-level margin survives catalog changes.
  purchasePrice Float  @default(0)
  discountMode  String @default("none")
  discountValue Float  @default(0)
  lineTotal     Float
  sortOrder     Int    @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model AdvancePayment {
  id              String   @id @default(cuid())
  companyId       String
  sampleSetId     String?
  sampleKey       String?
  customerId      String
  jobId           String?
  number          String
  amount          Float
  /// Sum of this advance's allocations across invoices.
  allocatedAmount Float    @default(0)
  method          String   @default("cash")
  reference       String?
  receivedAt      DateTime @default(now())
  notes           String?
  status          String   @default("draft")
  cancelledAt     DateTime?
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company     Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer    Customer                   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  job         Job?                       @relation(fields: [jobId], references: [id], onDelete: SetNull)
  allocations InvoiceAdvanceAllocation[]
  ledger      LedgerEntry[]

  @@unique([companyId, number])
  @@index([companyId, customerId])
  @@index([companyId, jobId])
  @@index([companyId, updatedAt])
  @@index([sampleSetId])
}

/// Records which advance settles which invoice. This moves no money: the cash
/// was already credited to the customer when the advance was received, so an
/// allocation only affects the net payable printed on one document.
model InvoiceAdvanceAllocation {
  id        String   @id @default(cuid())
  invoiceId String
  advanceId String
  amount    Float
  createdAt DateTime @default(now())

  invoice Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  advance AdvancePayment @relation(fields: [advanceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, advanceId])
  @@index([advanceId])
}

model LedgerEntry {
  id         String   @id @default(cuid())
  companyId  String
  customerId String
  jobId      String?
  invoiceId  String?
  advanceId  String?
  entryType  String
  direction  String
  amount     Float
  occurredAt DateTime @default(now())
  memo       String?
  createdAt  DateTime @default(now())

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  job      Job?            @relation(fields: [jobId], references: [id], onDelete: SetNull)
  invoice  Invoice?        @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  advance  AdvancePayment? @relation(fields: [advanceId], references: [id], onDelete: SetNull)

  @@index([companyId, customerId, occurredAt])
  @@index([companyId, jobId, occurredAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  companyId  String
  actorId    String?
  entityType String
  entityId   String
  action     String
  beforeJson String?
  afterJson  String?
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, entityType, entityId])
  @@index([companyId, createdAt])
}
