  phone     String?
  email     String?
  address   String?
  trn       String?
  notes     String?
  active    Boolean  @default(true)
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quotations Quotation[]
  jobs       Job[]
  invoices   Invoice[]
  advances   AdvancePayment[]
  ledger     LedgerEntry[]

  @@index([companyId, name])
  @@index([companyId, updatedAt])
  @@index([sampleSetId])
}

model Quotation {
  id            String    @id @default(cuid())
  companyId     String
  sampleSetId   String?
  sampleKey     String?
  customerId    String
  number        String
  /// general | counter_top
  kind          String    @default("general")
  status        String    @default("draft")
  title         String?
  notes         String?
  contactName   String?
  contactPhone  String?
  location      String?
  validUntil    DateTime?
  discountMode  String    @default("none")
  discountValue Float     @default(0)
  /// Applied document discount (AED), denormalized at save.
  discount      Float     @default(0)
  lineDiscountTotal Float @default(0)
  // Totals are denormalised so list screens and ledgers never re-derive money
  // from lines that a later product re-pricing could have changed.
  subtotal      Float     @default(0)
  vatAmount     Float     @default(0)
  total         Float     @default(0)
  purchaseTotal Float     @default(0)
  approvedAt    DateTime?
  cancelledAt   DateTime?
  /// Immediate parent when created via Revise (approved → next draft version).
  revisionOfId    String?
  /// First quotation in a revision chain (original v1).
  rootQuotationId String?
  /// 1 = original or copy-as-new; 2+ = revision index within the chain.
  revisionNumber  Int       @default(1)
  version       Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company     Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer    Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lines       QuotationLine[]
  sections    QuotationSection[]
  lookupLinks QuotationLookupLink[]
  job         Job?
  revisionOf    Quotation?  @relation("QuotationRevisionOf", fields: [revisionOfId], references: [id], onDelete: SetNull)
  revisions     Quotation[] @relation("QuotationRevisionOf")
  rootQuotation Quotation?  @relation("QuotationRoot", fields: [rootQuotationId], references: [id], onDelete: SetNull)
  derivedFromRoot Quotation[] @relation("QuotationRoot")

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([companyId, kind])
  @@index([companyId, customerId])
  @@index([companyId, updatedAt])
  @@index([companyId, rootQuotationId])
  @@index([sampleSetId])
}

model QuotationLine {
  id            String  @id @default(cuid())
  quotationId   String
  productId     String?
  description   String
  unit          String  @default("sqm")
  qty           Float
  // Captured per deal. Job P&L reads these, never the live catalog price.
  purchasePrice Float
  sellPrice     Float
  discountMode  String  @default("none")
  discountValue Float   @default(0)
  lineTotal     Float
  sortOrder     Int     @default(0)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([quotationId])
}

/// One vanity / counter block on a Counter Top quotation.
model QuotationSection {
  id          String @id @default(cuid())
  quotationId String
  productId   String?
  /// Catalog name or free-text product label shown at the top of the section.
  productName String
  amount      Float  @default(0)
  discountMode String @default("none")
  discountValue Float @default(0)
  sortOrder   Int    @default(0)

  quotation Quotation              @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product?               @relation(fields: [productId], references: [id], onDelete: SetNull)
  items     QuotationSectionItem[]

  @@index([quotationId])
}

/// Flexible label/value rows inside a Counter Top section (count varies).
model QuotationSectionItem {
  id        String @id @default(cuid())
  sectionId String
  label     String
  value     String @default("")
  /// Line amount for internal costing; summed into section.amount (not shown on PDF).
  amount    Float  @default(0)
  discountMode String @default("none")
  discountValue Float @default(0)
  sortOrder Int    @default(0)

  section QuotationSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
}

/// Company library of reusable T&Cs / notes / bank blocks for quotations.
model QuotationLookup {
  id        String   @id @default(cuid())
  companyId String
  sampleSetId String?
  sampleKey String?
  /// terms | notes | bank
  category  String
  /// general | counter_top | both
  appliesTo String   @default("both")
  title     String
  body      String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  links   QuotationLookupLink[]

  @@index([companyId, category])
  @@index([companyId, appliesTo])
  @@index([sampleSetId])
}

model QuotationLookupLink {
  quotationId String
  lookupId    String

  quotation Quotation       @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  lookup    QuotationLookup @relation(fields: [lookupId], references: [id], onDelete: Cascade)

  @@id([quotationId, lookupId])
  @@index([lookupId])
}

model Job {
  id            String    @id @default(cuid())
  companyId     String
  sampleSetId   String?
  sampleKey     String?
  customerId    String
  quotationId   String    @unique
  number        String
  status        String    @default("open")
  title         String?
