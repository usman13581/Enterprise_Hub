generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                   String    @id @default(cuid())
  name                 String
  slug                 String    @unique
  /// When set, company login and company APIs are blocked.
  suspendedAt          DateTime?
  industryCategoryId   String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  dataEpoch            Int       @default(0)

  profile              CompanyProfile?
  users                User[]
  auditLogs            AuditLog[]
  suppliers            Supplier[]
  products             Product[]
  customers            Customer[]
  quotations           Quotation[]
  jobs                 Job[]
  invoices             Invoice[]
  advances             AdvancePayment[]
  ledger               LedgerEntry[]
  quotationLookups     QuotationLookup[]
  industryCategory     IndustryCategory?           @relation(fields: [industryCategoryId], references: [id], onDelete: SetNull)
  subscription         CompanySubscription?
  renewalRequests      SubscriptionRenewalRequest[]
  applications         CompanyApplication[]
  notifications        Notification[]
  supportRequests      SupportRequest[]
  sampleDataSets       SampleDataSet[]
  hrDepartments        HRDepartment[]
  hrDesignations       HRDesignation[]
  hrWorkLocations      HRWorkLocation[]
  hrHolidays           HRHoliday[]
  hrEmployees          HREmployee[]
  hrEmployeeDocuments  HREmployeeDocument[]
  hrAttendance         HRAttendance[]
  hrOvertimeRequests   HROvertimeRequest[]
  hrLeaveTypes         HRLeaveType[]
  hrLeavePolicies      HRLeavePolicy[]
  hrLeaveBalances      HRLeaveBalance[]
  hrLeaveRequests      HRLeaveRequest[]
  hrPayrollPeriods     HRPayrollPeriod[]
  hrSalaryProfiles     HRSalaryProfile[]
  hrPayrollEntries     HRPayrollEntry[]
  hrExpenses           HRExpenseClaim[]
  hrLoans              HRLoan[]
  hrBenefits           HRBenefitPlan[]
  hrEmployeeBenefits   HREmployeeBenefit[]
  hrAssets             HRAsset[]
  hrAssetAssignments   HRAssetAssignment[]
  hrComplianceRecords  HRComplianceRecord[]
  hrPerformanceGoals   HRPerformanceGoal[]
  hrTrainingRecords    HRTrainingRecord[]
  hrPolicyProfile      HRPolicyProfile?
  lpos                 Lpo[]
  lpoLines             LpoLine[]
  lpoReceipts          LpoReceipt[]
  lpoReceiptLines      LpoReceiptLine[]
  purchaseInvoices     PurchaseInvoice[]
  purchaseInvoiceLines PurchaseInvoiceLine[]
  supplierPayments     SupplierPayment[]
  supplierPaymentAllocations SupplierPaymentAllocation[]
  supplierLedgerEntries SupplierLedgerEntry[]
  purchasePriceHistory SupplierPriceHistory[]
}

model PlatformAdmin {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  decidedApplications CompanyApplication[]       @relation("ApplicationDecidedBy")
  decidedRenewals     SubscriptionRenewalRequest[] @relation("RenewalDecidedBy")
  notificationsSent   Notification[]             @relation("NotificationByAdmin")
  supportClosed       SupportRequest[]           @relation("SupportClosedByAdmin")
  sessions             AuthSession[]
}

model Plan {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  /// monthly | yearly
  interval  String   @default("monthly")
  /// List price in USD (subscription billing currency).
  priceUsd  Float    @default(0) @map("priceAed")
  trialDays Int      @default(14)
  /// 0 = unlimited (Custom / contact sales)
  maxUsers  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions CompanySubscription[]
}

model CompanySubscription {
  id                 String    @id @default(cuid())
  companyId          String    @unique
  planId             String
  /// trial | active | past_due | suspended | cancelled
  status             String    @default("trial")
  /// manual only in this backlog
  billingChannel     String    @default("manual")
  startsAt           DateTime  @default(now())
  trialEndsAt        DateTime?
  expiresAt          DateTime?
  seatsIncluded      Int       @default(0)
  seatsOverride      Int?
  note               String?
  lastPaymentAmount  Float?
  lastPaymentAt      DateTime?
  lastPaymentRef     String?
  lastExpiryNoticeAt DateTime?
  isDemo             Boolean   @default(false)
  demoCleanupStatus  String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan    Plan    @relation(fields: [planId], references: [id])
}

model SampleDataSet {
  id             String   @id @default(cuid())
  companyId      String
  templateKey    String
  templateVersion Int     @default(1)
  /// loaded | erasing | erased | failed
  status         String   @default("loaded")
  loadedAt       DateTime @default(now())
  erasedAt       DateTime?
  error          String?
  /// Internal linkage for HR and other entities without sampleSetId (not shown in UI).
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, templateKey])
  @@index([companyId, status])
}

model SubscriptionRenewalRequest {
  id                 String    @id @default(cuid())
  companyId          String
  submittedByUserId  String
  amount             Float
  paidAt             DateTime
  bankReference      String?
  notes              String?
  depositDocumentUrl String
  /// pending | approved | rejected
  status             String    @default("pending")
  rejectReason       String?
  decidedAt          DateTime?
  decidedByAdminId   String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  submittedBy   User           @relation(fields: [submittedByUserId], references: [id], onDelete: Cascade)
  decidedBy     PlatformAdmin? @relation("RenewalDecidedBy", fields: [decidedByAdminId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([status, createdAt])
}

model CompanyApplication {
  id               String    @id @default(cuid())
  /// pending | approved | rejected
  status           String    @default("pending")
  /// manual | demo
  kind             String    @default("manual")
  /// pending | approved | rejected | provisioned | demo_expired | demo_cleaned | demo_cancelled
  lifecycleStatus  String    @default("pending")
  rejectReason     String?
  decidedAt        DateTime?
  decidedByAdminId String?
  companyId        String?
  source           String    @default("website")
  legalName        String
  tradeName        String?
  contactName      String
  email            String
  phone            String
  /// ISO 3166-1 alpha-2 from the shared countries list.
  country          String   @default("AE")
  emirate          String
  trn              String?
  approxUsers      String?
  planInterest     String?
  needs            String?
  heardFrom        String?
  note             String?
  honeypot         String?
  ip               String?
  provisionedAt    DateTime?
  cleanedAt        DateTime?
  cleanupError     String?
  credentialStatus String?
  credentialHandoff String?
  credentialExpiresAt DateTime?
  credentialRevealedAt DateTime?
  demoEmailKey     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company   Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  decidedBy PlatformAdmin? @relation("ApplicationDecidedBy", fields: [decidedByAdminId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([email])
}

model Notification {
  id                       String   @id @default(cuid())
  companyId                String?
  /// platform | company | system
  source                   String
  /// admin_to_company | company_internal | subscription | expiry_subscription | expiry_user | support
  kind                     String
  title                    String
  body                     String
  /// company_admins | all_users | one_user
  audience                 String
  userId                   String?
  createdByPlatformAdminId String?
  createdByUserId          String?
  createdAt                DateTime @default(now())

  company              Company?       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdByAdmin       PlatformAdmin? @relation("NotificationByAdmin", fields: [createdByPlatformAdminId], references: [id], onDelete: SetNull)
  createdByUser        User?          @relation("NotificationByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  targetUser           User?          @relation("NotificationTargetUser", fields: [userId], references: [id], onDelete: SetNull)
  receipts             NotificationReceipt[]

  @@index([companyId, createdAt])
}

model NotificationReceipt {
  id             String    @id @default(cuid())
  notificationId String
  userId         String
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, readAt])
}

model SupportRequest {
  id               String    @id @default(cuid())
  companyId        String
  createdByUserId  String
  title            String
  body             String
  attachmentUrl    String?
  /// open | closed
  status           String    @default("open")
  closedAt         DateTime?
  /// company_admin | platform_admin
  closedByKind     String?
  closedByUserId   String?
  closedByAdminId  String?
  closeNote        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy     User           @relation("SupportCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  closedByUser  User?          @relation("SupportClosedByUser", fields: [closedByUserId], references: [id], onDelete: SetNull)
  closedByAdmin PlatformAdmin? @relation("SupportClosedByAdmin", fields: [closedByAdminId], references: [id], onDelete: SetNull)

  @@index([companyId, status, createdAt])
}

model IndustryCategory {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companies Company[]
  features  AppFeatureOnCategory[]
}

model AppFeature {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories AppFeatureOnCategory[]
}

model AppFeatureOnCategory {
  featureId  String
  categoryId String

  feature  AppFeature       @relation(fields: [featureId], references: [id], onDelete: Cascade)
  category IndustryCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([featureId, categoryId])
}

model CompanyProfile {
  id               String   @id @default(cuid())
  companyId        String   @unique
  legalName        String
  tradeName        String?
  address          String?
  phone            String?
  email            String?
  trn              String?
  bankDetails      String?
  logoUrl          String?
  signatureUrl     String?
  quotationPrefix  String   @default("QT")
  invoicePrefix    String   @default("INV")
  jobPrefix        String   @default("JOB")
  advancePrefix    String   @default("ADV")
  creditNotePrefix String   @default("CN")
  lpoPrefix        String   @default("LPO")
  purchaseInvoicePrefix String @default("PINV")
  supplierPaymentPrefix String @default("SPAY")
  /// ISO 3166-1 alpha-2. Currency below is derived from this at signup/profile save.
  country          String   @default("AE")
  currency         String   @default("AED")
  vatRate          Float    @default(0.05)
  /// Bumped on every sync-visible write for offline conflict checks.
  version          Int      @default(1)
  updatedAt        DateTime @default(now()) @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model User {
  id              String    @id @default(cuid())
  companyId       String
  email           String
  name            String
  /// bcrypt hash; null only for legacy rows before login existed.
  passwordHash    String?
  active          Boolean   @default(true)
  /// admin | member
  companyRole     String    @default("member")
  accessExpiresAt DateTime?
  mustChangePassword Boolean @default(false)
  passwordChangedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company              Company                      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  renewalRequests      SubscriptionRenewalRequest[]
  notificationsCreated Notification[]               @relation("NotificationByUser")
  notificationsTarget  Notification[]               @relation("NotificationTargetUser")
  notificationReceipts NotificationReceipt[]
  supportCreated       SupportRequest[]             @relation("SupportCreatedBy")
  supportClosed        SupportRequest[]             @relation("SupportClosedByUser")
  sessions              AuthSession[]
  hrEmployee            HREmployee?

  @@unique([companyId, email])
  @@index([companyId, companyRole, active])
}

model HRDepartment {
  id        String   @id @default(cuid())
  companyId String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees HREmployee[]

  @@unique([companyId, name])
  @@index([companyId, active])
}

model HRDesignation {
  id        String   @id @default(cuid())
  companyId String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees HREmployee[]

  @@unique([companyId, name])
  @@index([companyId, active])
}

model HRWorkLocation {
  id        String   @id @default(cuid())
  companyId String
  name      String
  kind      String   @default("office")
  address   String?
  latitude  Float?
  longitude Float?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  attendance HRAttendance[]

  @@unique([companyId, name])
  @@index([companyId, active])
}

model HRHoliday {
  id        String   @id @default(cuid())
  companyId String
  name      String
  date      DateTime
  recurring Boolean  @default(false)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, date])
  @@index([companyId, date])
}

model HRPolicyProfile {
  id                 String   @id @default(cuid())
  companyId          String   @unique
  jurisdiction       String   @default("mainland")
  payFrequency       String   @default("monthly")
  standardHoursPerDay Float   @default(8)
  workingDaysPerWeek Int      @default(6)
  overtimeMultiplier  Float    @default(1.25)
  annualLeaveDays    Float    @default(30)
  sickLeaveDays      Float    @default(90)
  emiratisationTarget Float?
  currency           String   @default("AED")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model HREmployee {
  id                String    @id @default(cuid())
  companyId         String
  userId            String?   @unique
  employeeNumber    String
  firstName         String
  lastName          String?
  preferredName     String?
  email             String?
  phone             String?
  photoUrl          String?
  nationality       String?
  emergencyContact  String?
  emergencyPhone    String?
  emiratesIdNumber  String?
  emiratesIdIssueDate DateTime?
  emiratesIdExpiry  DateTime?
  passportNumber    String?
  passportCountry   String?
  passportIssueDate DateTime?
  passportExpiry    DateTime?
  visaExpiry        DateTime?
  workPermitExpiry  DateTime?
  employmentType    String    @default("full_time")
  status            String    @default("active")
  departmentId      String?
  designationId     String?
  managerId         String?
  joiningDate       DateTime
  probationEndDate  DateTime?
  terminationDate   DateTime?
  bankName          String?
  bankAccountLast4  String?
  ibanLast4         String?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company       Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user          User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  department    HRDepartment?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation   HRDesignation?        @relation(fields: [designationId], references: [id], onDelete: SetNull)
  manager       HREmployee?           @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports       HREmployee[]          @relation("EmployeeManager")
  documents     HREmployeeDocument[]
  attendance    HRAttendance[]
  overtime      HROvertimeRequest[]
  leaveRequests HRLeaveRequest[]
  leaveBalances HRLeaveBalance[]
  salaryProfiles HRSalaryProfile[]
  payrollEntries HRPayrollEntry[]
  expenses      HRExpenseClaim[]
  loans         HRLoan[]
  benefits      HREmployeeBenefit[]
  assignedAssets HRAssetAssignment[]
  compliance    HRComplianceRecord[]
  performanceGoals HRPerformanceGoal[]
  trainingRecords HRTrainingRecord[]

  @@unique([companyId, employeeNumber])
  @@index([companyId, status, departmentId])
  @@index([companyId, joiningDate])
}

model HREmployeeDocument {
  id             String    @id @default(cuid())
  companyId      String
  employeeId     String
  documentType   String
  documentNumber String?
  issueDate      DateTime?
  expiryDate     DateTime?
  issuingCountry String?
  issuingAuthority String?
  fileUrl        String?
  notes          String?
  status         String    @default("current")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company  Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee HREmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId, employeeId, documentType])
  @@index([companyId, expiryDate])
}

model HRAttendance {
  id             String    @id @default(cuid())
  companyId      String
  employeeId     String
  workLocationId String?
  checkInAt      DateTime
  checkOutAt     DateTime?
  breakStartedAt DateTime?
  breakEndedAt   DateTime?
  context        String    @default("office")
  latitude       Float?
  longitude      Float?
  accuracyMeters Float?
  capturedAt     DateTime
  devicePlatform String?
  ipAddress      String?
  status         String    @default("present")
  correctionNote String?
  suspicious     Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee     HREmployee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workLocation HRWorkLocation?  @relation(fields: [workLocationId], references: [id], onDelete: SetNull)

  @@index([companyId, employeeId, checkInAt])
  @@index([companyId, status, checkInAt])
}

model HROvertimeRequest {
  id             String    @id @default(cuid())
  companyId      String
  employeeId     String
  workDate       DateTime
  startedAt      DateTime
  endedAt        DateTime
  breakMinutes   Int       @default(0)
  requestedHours Float
  approvedHours  Float?
  multiplier     Float     @default(1.25)
  reason         String
  status         String    @default("pending")
  reviewedByUserId String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company  Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee HREmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId, employeeId, workDate])
  @@index([companyId, status, workDate])
}

model HRLeaveType {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  code        String
  paid        Boolean  @default(true)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  policies HRLeavePolicy[]
  requests HRLeaveRequest[]
  balances HRLeaveBalance[]

  @@unique([companyId, code])
  @@index([companyId, active])
}

model HRLeavePolicy {
  id             String   @id @default(cuid())
  companyId      String
  leaveTypeId    String
  employmentType String?
  annualDays     Float
  carryForwardDays Float @default(0)
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leaveType HRLeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@index([companyId, leaveTypeId, effectiveFrom])
}

model HRLeaveBalance {
  id          String   @id @default(cuid())
  companyId   String
  employeeId  String
  leaveTypeId String
  year        Int
  entitled    Float
  used        Float    @default(0)
  carried    Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee HREmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType HRLeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([companyId, employeeId, leaveTypeId, year])
  @@index([companyId, employeeId, year])
}

model HRLeaveRequest {
  id            String   @id @default(cuid())
  companyId     String
  employeeId    String
  leaveTypeId   String
  startDate     DateTime
  endDate       DateTime
  days          Float
  reason        String?
  status        String   @default("pending")
  reviewedByUserId String?
  reviewedAt    DateTime?
  reviewNote    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company  Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee HREmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType HRLeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@index([companyId, employeeId, startDate, endDate])
  @@index([companyId, status, startDate])
}

model HRPayrollPeriod {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  startDate   DateTime
  endDate     DateTime
  payDate     DateTime?
  status      String   @default("draft")
  calculatedAt DateTime?
  approvedAt  DateTime?
  lockedAt    DateTime?
  paidAt      DateTime?
  totalGross  Float    @default(0)
  totalDeductions Float @default(0)
  totalNet    Float    @default(0)
  warningsJson String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  entries HRPayrollEntry[]

  @@unique([companyId, startDate, endDate])
  @@index([companyId, status, startDate])
}

model HRSalaryProfile {
  id             String   @id @default(cuid())
  companyId      String
  employeeId     String
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  basicSalary    Float    @default(0)
  housingAllowance Float  @default(0)
  transportAllowance Float @default(0)
  otherAllowance Float    @default(0)
  overtimeRate   Float    @default(1.25)
  currency       String   @default("AED")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company  Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee HREmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId, employeeId, effectiveFrom])
}

model HRPayrollEntry {
  id             String   @id @default(cuid())
  companyId      String
  periodId       String
  employeeId     String
  basicSalary    Float    @default(0)
  allowances     Float    @default(0)
  overtimeAmount Float    @default(0)
  bonus          Float    @default(0)
  deductions     Float    @default(0)
  unpaidLeaveDeduction Float @default(0)
  loanDeduction  Float    @default(0)
  grossAmount    Float    @default(0)
  netAmount      Float    @default(0)
  breakdownJson  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  period   HRPayrollPeriod  @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employee HREmployee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([periodId, employeeId])
  @@index([companyId, employeeId])
}

model HRExpenseClaim {
  id          String   @id @default(cuid())
  companyId   String
  employeeId  String
  expenseDate DateTime
  category    String
  amount      Float
  description String
  receiptUrl  String?
  status      String   @default("pending")
  reviewedByUserId String?
  reviewedAt  DateTime?
  reimbursedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee HREmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId, employeeId, expenseDate])
