generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                   String    @id @default(cuid())
  name                 String
  slug                 String    @unique
  /// When set, company login and company APIs are blocked.
  suspendedAt          DateTime?
  industryCategoryId   String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  dataEpoch            Int       @default(0)

  profile              CompanyProfile?
  users                User[]
  auditLogs            AuditLog[]
  suppliers            Supplier[]
  products             Product[]
  customers            Customer[]
  quotations           Quotation[]
  jobs                 Job[]
  invoices             Invoice[]
  advances             AdvancePayment[]
  ledger               LedgerEntry[]
  quotationLookups     QuotationLookup[]
  industryCategory     IndustryCategory?           @relation(fields: [industryCategoryId], references: [id], onDelete: SetNull)
  subscription         CompanySubscription?
  renewalRequests      SubscriptionRenewalRequest[]
  applications         CompanyApplication[]
  notifications        Notification[]
  supportRequests      SupportRequest[]
  sampleDataSets       SampleDataSet[]
}

model PlatformAdmin {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  decidedApplications CompanyApplication[]       @relation("ApplicationDecidedBy")
  decidedRenewals     SubscriptionRenewalRequest[] @relation("RenewalDecidedBy")
  notificationsSent   Notification[]             @relation("NotificationByAdmin")
  supportClosed       SupportRequest[]           @relation("SupportClosedByAdmin")
  sessions             AuthSession[]
}

model Plan {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  /// monthly | yearly
  interval  String   @default("monthly")
  priceAed  Float    @default(0)
  trialDays Int      @default(14)
  /// 0 = unlimited
  maxUsers  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions CompanySubscription[]
}

model CompanySubscription {
  id                 String    @id @default(cuid())
  companyId          String    @unique
  planId             String
  /// trial | active | past_due | suspended | cancelled
  status             String    @default("trial")
  /// manual only in this backlog
  billingChannel     String    @default("manual")
  startsAt           DateTime  @default(now())
  trialEndsAt        DateTime?
  expiresAt          DateTime?
  seatsIncluded      Int       @default(0)
  seatsOverride      Int?
  note               String?
  lastPaymentAmount  Float?
  lastPaymentAt      DateTime?
  lastPaymentRef     String?
  lastExpiryNoticeAt DateTime?
  isDemo             Boolean   @default(false)
  demoCleanupStatus  String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan    Plan    @relation(fields: [planId], references: [id])
}

model SampleDataSet {
  id             String   @id @default(cuid())
  companyId      String
  templateKey    String
  templateVersion Int     @default(1)
  /// loaded | erasing | erased | failed
  status         String   @default("loaded")
  loadedAt       DateTime @default(now())
  erasedAt       DateTime?
  error          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, templateKey])
  @@index([companyId, status])
}

model SubscriptionRenewalRequest {
  id                 String    @id @default(cuid())
  companyId          String
  submittedByUserId  String
  amount             Float
  paidAt             DateTime
  bankReference      String?
  notes              String?
  depositDocumentUrl String
  /// pending | approved | rejected
  status             String    @default("pending")
  rejectReason       String?
  decidedAt          DateTime?
  decidedByAdminId   String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  submittedBy   User           @relation(fields: [submittedByUserId], references: [id], onDelete: Cascade)
  decidedBy     PlatformAdmin? @relation("RenewalDecidedBy", fields: [decidedByAdminId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([status, createdAt])
}

model CompanyApplication {
  id               String    @id @default(cuid())
  /// pending | approved | rejected
  status           String    @default("pending")
  /// manual | demo
  kind             String    @default("manual")
  /// pending | approved | rejected | provisioned | demo_expired | demo_cleaned | demo_cancelled
  lifecycleStatus  String    @default("pending")
  rejectReason     String?
  decidedAt        DateTime?
  decidedByAdminId String?
  companyId        String?
  source           String    @default("website")
  legalName        String
  tradeName        String?
  contactName      String
  email            String
  phone            String
  emirate          String
  trn              String?
  approxUsers      String?
  planInterest     String?
  needs            String?
  heardFrom        String?
  note             String?
  honeypot         String?
  ip               String?
  provisionedAt    DateTime?
  cleanedAt        DateTime?
  cleanupError     String?
  credentialStatus String?
  credentialHandoff String?
  credentialExpiresAt DateTime?
  credentialRevealedAt DateTime?
  demoEmailKey     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company   Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  decidedBy PlatformAdmin? @relation("ApplicationDecidedBy", fields: [decidedByAdminId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([email])
}

model Notification {
  id                       String   @id @default(cuid())
  companyId                String?
  /// platform | company | system
  source                   String
  /// admin_to_company | company_internal | subscription | expiry_subscription | expiry_user | support
  kind                     String
  title                    String
  body                     String
  /// company_admins | all_users | one_user
  audience                 String
  userId                   String?
  createdByPlatformAdminId String?
  createdByUserId          String?
  createdAt                DateTime @default(now())

  company              Company?       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdByAdmin       PlatformAdmin? @relation("NotificationByAdmin", fields: [createdByPlatformAdminId], references: [id], onDelete: SetNull)
  createdByUser        User?          @relation("NotificationByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  targetUser           User?          @relation("NotificationTargetUser", fields: [userId], references: [id], onDelete: SetNull)
  receipts             NotificationReceipt[]

  @@index([companyId, createdAt])
}

model NotificationReceipt {
  id             String    @id @default(cuid())
  notificationId String
  userId         String
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, readAt])
}

model SupportRequest {
  id               String    @id @default(cuid())
  companyId        String
  createdByUserId  String
  title            String
  body             String
  attachmentUrl    String?
  /// open | closed
  status           String    @default("open")
  closedAt         DateTime?
  /// company_admin | platform_admin
  closedByKind     String?
  closedByUserId   String?
  closedByAdminId  String?
  closeNote        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy     User           @relation("SupportCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  closedByUser  User?          @relation("SupportClosedByUser", fields: [closedByUserId], references: [id], onDelete: SetNull)
  closedByAdmin PlatformAdmin? @relation("SupportClosedByAdmin", fields: [closedByAdminId], references: [id], onDelete: SetNull)

  @@index([companyId, status, createdAt])
}

model IndustryCategory {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companies Company[]
  features  AppFeatureOnCategory[]
}

model AppFeature {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories AppFeatureOnCategory[]
}

model AppFeatureOnCategory {
  featureId  String
  categoryId String

  feature  AppFeature       @relation(fields: [featureId], references: [id], onDelete: Cascade)
  category IndustryCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([featureId, categoryId])
}

model CompanyProfile {
  id               String   @id @default(cuid())
  companyId        String   @unique
  legalName        String
  tradeName        String?
  address          String?
  phone            String?
  email            String?
  trn              String?
  bankDetails      String?
  logoUrl          String?
  signatureUrl     String?
  quotationPrefix  String   @default("QT")
  invoicePrefix    String   @default("INV")
  jobPrefix        String   @default("JOB")
  advancePrefix    String   @default("ADV")
  creditNotePrefix String   @default("CN")
  currency         String   @default("AED")
  vatRate          Float    @default(0.05)
  /// Bumped on every sync-visible write for offline conflict checks.
  version          Int      @default(1)
  updatedAt        DateTime @default(now()) @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model User {
  id              String    @id @default(cuid())
  companyId       String
  email           String
  name            String
  /// bcrypt hash; null only for legacy rows before login existed.
  passwordHash    String?
  active          Boolean   @default(true)
  /// admin | member
  companyRole     String    @default("member")
  accessExpiresAt DateTime?
  mustChangePassword Boolean @default(false)
  passwordChangedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company              Company                      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  renewalRequests      SubscriptionRenewalRequest[]
  notificationsCreated Notification[]               @relation("NotificationByUser")
  notificationsTarget  Notification[]               @relation("NotificationTargetUser")
  notificationReceipts NotificationReceipt[]
  supportCreated       SupportRequest[]             @relation("SupportCreatedBy")
  supportClosed        SupportRequest[]             @relation("SupportClosedByUser")
  sessions              AuthSession[]

  @@unique([companyId, email])
  @@index([companyId, companyRole, active])
}

model AuthSession {
  id                String    @id
  kind              String
  tokenHash         String    @unique
  userId            String?
  platformAdminId   String?
  actingAdminId     String?
  readOnly          Boolean   @default(false)
  createdAt         DateTime  @default(now())
  lastActivityAt    DateTime  @default(now())
  absoluteExpiresAt DateTime
  revokedAt         DateTime?

  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  platformAdmin PlatformAdmin? @relation(fields: [platformAdminId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([platformAdminId, revokedAt])
  @@index([absoluteExpiresAt])
}

model Supplier {
  id        String   @id @default(cuid())
  companyId String
  sampleSetId String?
  sampleKey String?
  name      String
  contact   String?
  phone     String?
  email     String?
  address   String?
  trn       String?
  notes     String?
  active    Boolean  @default(true)
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([companyId, name])
  @@index([sampleSetId])
  @@index([companyId, updatedAt])
}

model Product {
  id            String   @id @default(cuid())
  companyId     String
  sampleSetId   String?
  sampleKey     String?
  supplierId    String?
  name          String
  sku           String?
  unit          String   @default("sqm")
  purchasePrice Float    @default(0)
  sellPrice     Float    @default(0)
  description   String?
  active        Boolean  @default(true)
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier       Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  images         ProductImage[]
  quotationLines QuotationLine[]
  quotationSections QuotationSection[]

  @@index([companyId, name])
  @@index([companyId, updatedAt])
  @@index([sampleSetId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  isDefault Boolean  @default(false)
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([updatedAt])
}

model Customer {
  id        String   @id @default(cuid())
  companyId String
  sampleSetId String?
  sampleKey String?
  name      String
  contact   String?
  phone     String?
  email     String?
  address   String?
  trn       String?
  notes     String?
  active    Boolean  @default(true)
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quotations Quotation[]
  jobs       Job[]
  invoices   Invoice[]
  advances   AdvancePayment[]
  ledger     LedgerEntry[]

  @@index([companyId, name])
  @@index([companyId, updatedAt])
  @@index([sampleSetId])
}

model Quotation {
  id            String    @id @default(cuid())
  companyId     String
  sampleSetId   String?
  sampleKey     String?
  customerId    String
  number        String
  /// general | counter_top
  kind          String    @default("general")
  status        String    @default("draft")
  title         String?
  notes         String?
  contactName   String?
  contactPhone  String?
  location      String?
  validUntil    DateTime?
  /// Quote-level discount (mainly Counter Top); applied before VAT.
  discount      Float     @default(0)
  // Totals are denormalised so list screens and ledgers never re-derive money
  // from lines that a later product re-pricing could have changed.
  subtotal      Float     @default(0)
  vatAmount     Float     @default(0)
  total         Float     @default(0)
  purchaseTotal Float     @default(0)
  approvedAt    DateTime?
  cancelledAt   DateTime?
  version       Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company     Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer    Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lines       QuotationLine[]
  sections    QuotationSection[]
  lookupLinks QuotationLookupLink[]
  job         Job?

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([companyId, kind])
  @@index([companyId, customerId])
  @@index([companyId, updatedAt])
  @@index([sampleSetId])
}

model QuotationLine {
  id            String  @id @default(cuid())
  quotationId   String
  productId     String?
  description   String
  unit          String  @default("sqm")
  qty           Float
  // Captured per deal. Job P&L reads these, never the live catalog price.
  purchasePrice Float
  sellPrice     Float
  lineTotal     Float
  sortOrder     Int     @default(0)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([quotationId])
}

/// One vanity / counter block on a Counter Top quotation.
model QuotationSection {
  id          String @id @default(cuid())
  quotationId String
  productId   String?
  /// Catalog name or free-text product label shown at the top of the section.
  productName String
  amount      Float  @default(0)
  sortOrder   Int    @default(0)

  quotation Quotation              @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product?               @relation(fields: [productId], references: [id], onDelete: SetNull)
  items     QuotationSectionItem[]

  @@index([quotationId])
}

/// Flexible label/value rows inside a Counter Top section (count varies).
model QuotationSectionItem {
  id        String @id @default(cuid())
  sectionId String
  label     String
  value     String @default("")
  /// Line amount for internal costing; summed into section.amount (not shown on PDF).
  amount    Float  @default(0)
  sortOrder Int    @default(0)

  section QuotationSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
}

/// Company library of reusable T&Cs / notes / bank blocks for quotations.
model QuotationLookup {
  id        String   @id @default(cuid())
  companyId String
  sampleSetId String?
  sampleKey String?
  /// terms | notes | bank
  category  String
  /// general | counter_top | both
  appliesTo String   @default("both")
  title     String
  body      String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  links   QuotationLookupLink[]

  @@index([companyId, category])
  @@index([companyId, appliesTo])
  @@index([sampleSetId])
}

model QuotationLookupLink {
  quotationId String
  lookupId    String

  quotation Quotation       @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  lookup    QuotationLookup @relation(fields: [lookupId], references: [id], onDelete: Cascade)

  @@id([quotationId, lookupId])
  @@index([lookupId])
}

model Job {
  id            String    @id @default(cuid())
  companyId     String
  sampleSetId   String?
  sampleKey     String?
  customerId    String
  quotationId   String    @unique
  number        String
  status        String    @default("open")
  title         String?
  /// Gross, VAT-inclusive value carried over from the approved quotation.
  jobValue      Float     @default(0)
  /// Net of VAT, used for margin so collected VAT is not counted as revenue.
  jobNet        Float     @default(0)
  purchaseTotal Float     @default(0)
  completedAt   DateTime?
  closedAt      DateTime?
  version       Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer  Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quotation Quotation        @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  invoices  Invoice[]
  advances  AdvancePayment[]
  ledger    LedgerEntry[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([companyId, customerId])
  @@index([companyId, updatedAt])
  @@index([sampleSetId])
}

model Invoice {
  id         String  @id @default(cuid())
  companyId  String
  sampleSetId String?
  sampleKey String?
  customerId String
  jobId      String?
  number     String
  kind       String
  status     String  @default("issued")

  issueDate DateTime  @default(now())
  dueDate   DateTime?
  notes     String?

  subtotal       Float @default(0)
  vatAmount      Float @default(0)
  total          Float @default(0)
  purchaseTotal  Float @default(0)
  /// Advance shown as settled on this document; see InvoiceAdvanceAllocation.
  advanceApplied Float @default(0)
  netPayable     Float @default(0)

  creditNoteForId String?
  cancelledAt     DateTime?
  version         Int       @default(1)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company       Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer      Customer                   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  job           Job?                       @relation(fields: [jobId], references: [id], onDelete: SetNull)
  creditNoteFor Invoice?                   @relation("CreditNotes", fields: [creditNoteForId], references: [id], onDelete: SetNull)
  creditNotes   Invoice[]                  @relation("CreditNotes")
  lines         InvoiceLine[]
  allocations   InvoiceAdvanceAllocation[]
  ledger        LedgerEntry[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([companyId, customerId])
  @@index([companyId, jobId])
  @@index([companyId, updatedAt])
  @@index([sampleSetId])
}

model InvoiceLine {
  id            String @id @default(cuid())
  invoiceId     String
  description   String
  unit          String @default("sqm")
  qty           Float
  unitPrice     Float
  /// Snapshot of cost so invoice-level margin survives catalog changes.
  purchasePrice Float  @default(0)
  lineTotal     Float
  sortOrder     Int    @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model AdvancePayment {
  id              String   @id @default(cuid())
  companyId       String
  sampleSetId     String?
  sampleKey       String?
  customerId      String
  jobId           String?
  number          String
  amount          Float
  /// Sum of this advance's allocations across invoices.
  allocatedAmount Float    @default(0)
  method          String   @default("cash")
  reference       String?
  receivedAt      DateTime @default(now())
  notes           String?
  cancelledAt     DateTime?
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company     Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer    Customer                   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  job         Job?                       @relation(fields: [jobId], references: [id], onDelete: SetNull)
  allocations InvoiceAdvanceAllocation[]
  ledger      LedgerEntry[]

  @@unique([companyId, number])
  @@index([companyId, customerId])
  @@index([companyId, jobId])
  @@index([companyId, updatedAt])
  @@index([sampleSetId])
}

/// Records which advance settles which invoice. This moves no money: the cash
/// was already credited to the customer when the advance was received, so an
/// allocation only affects the net payable printed on one document.
model InvoiceAdvanceAllocation {
  id        String   @id @default(cuid())
  invoiceId String
  advanceId String
  amount    Float
  createdAt DateTime @default(now())

  invoice Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  advance AdvancePayment @relation(fields: [advanceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, advanceId])
  @@index([advanceId])
}

model LedgerEntry {
  id         String   @id @default(cuid())
  companyId  String
  customerId String
  jobId      String?
  invoiceId  String?
  advanceId  String?
  entryType  String
  direction  String
  amount     Float
  occurredAt DateTime @default(now())
  memo       String?
  createdAt  DateTime @default(now())

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  job      Job?            @relation(fields: [jobId], references: [id], onDelete: SetNull)
  invoice  Invoice?        @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  advance  AdvancePayment? @relation(fields: [advanceId], references: [id], onDelete: SetNull)

  @@index([companyId, customerId, occurredAt])
  @@index([companyId, jobId, occurredAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  companyId  String
  actorId    String?
  entityType String
  entityId   String
  action     String
  beforeJson String?
  afterJson  String?
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, entityType, entityId])
  @@index([companyId, createdAt])
}
