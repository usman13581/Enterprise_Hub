# Copy to apps/mobile/.env before running Expo.

# Local development (Expo Go on a phone):
# Leave EXPO_PUBLIC_API_URL unset. The app auto-detects your Mac's LAN IP on
# port 3001 from the Metro host. Start the API with `pnpm dev:api` first.
#
# To hit production from a dev build instead, set:
# EXPO_PUBLIC_USE_PRODUCTION_API=1
# EXPO_PUBLIC_API_URL="https://marble-api-production.up.railway.app"
#
# Or pin a LAN API explicitly:
# EXPO_PUBLIC_API_URL="http://192.168.1.50:3001"

# Must match BOOTSTRAP_TOKEN in apps/api/.env.
EXPO_PUBLIC_BOOTSTRAP_TOKEN="binhaj-dev-token"
