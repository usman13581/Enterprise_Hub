# Copy to apps/mobile/.env before running Expo.

# Leave unset to auto-detect the Expo host machine's LAN IP, which is what a
# physical phone on the same Wi-Fi needs. Set it explicitly when the API runs
# somewhere else. "localhost" will not resolve from a real device.
# EXPO_PUBLIC_API_URL="http://192.168.1.50:3001"

# Must match BOOTSTRAP_TOKEN in apps/api/.env.
EXPO_PUBLIC_BOOTSTRAP_TOKEN="binhaj-dev-token"
