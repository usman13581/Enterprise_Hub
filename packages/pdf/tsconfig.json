{
  "compilerOptions": {
    "target": "ES2021",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2021", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "esModuleInterop": true,
    "jsx": "react",
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/**/*"]
}
