{
  "name": "marble-with-nuage",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @marble/api --filter @marble/web --filter @marble/mobile dev",
    "dev:api": "pnpm --filter @marble/api dev",
    "dev:web": "pnpm --filter @marble/web dev",
    "dev:mobile": "pnpm --filter @marble/mobile start",
    "db:push": "pnpm --filter @marble/api db:push",
    "db:seed": "pnpm --filter @marble/api db:seed",
    "db:generate": "pnpm --filter @marble/api prisma:generate",
    "build:packages": "pnpm --filter @marble/types build && pnpm --filter @marble/domain build && pnpm --filter @marble/pdf build",
    "build": "pnpm build:packages && pnpm -r --filter @marble/api --filter @marble/web build",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "test": "pnpm build:packages && pnpm -r test",
    "verify": "pnpm db:generate && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "vitest": "^3"
  }
}
