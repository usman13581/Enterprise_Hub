FROM node:22-bookworm-slim

RUN apt-get update -y \
  && apt-get install -y openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

WORKDIR /app

COPY . .

# prepare scripts expect full source; build explicitly after install
RUN pnpm install --frozen-lockfile --ignore-scripts
RUN pnpm railway:build:api

ENV NODE_ENV=production
ENV HOST=0.0.0.0
# Persist product images via Railway Volume mounted at /data/uploads
ENV UPLOADS_DIR=/data/uploads

RUN chmod +x scripts/railway-start-api.sh

CMD ["bash", "scripts/railway-start-api.sh"]
